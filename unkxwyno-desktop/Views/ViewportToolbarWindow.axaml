<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Unkxwyno.Desktop.Views.ViewportToolbarWindow"
        Title="unkXwyno Quick Toolbar"
        Width="380" Height="36"
        CanResize="False"
        ShowInTaskbar="False"
        Topmost="True"
        SystemDecorations="None"
        Background="Transparent"
        WindowStartupLocation="Manual">

    <Border Background="#141923EE"
            BorderBrush="#232B3A"
            BorderThickness="1"
            CornerRadius="18"
            BoxShadow="0 4 16 #88000000"
            Padding="8,2">
        <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
            <!-- Brand Badge -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" Margin="4,0,8,0">
                <Border Width="8" Height="8" CornerRadius="4" Background="#00E5FF" VerticalAlignment="Center" />
                <TextBlock Text="unkXwyno" FontSize="11" FontWeight="Bold" Foreground="#00E5FF" VerticalAlignment="Center" />
            </StackPanel>

            <!-- Action Icon Buttons -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
                <!-- Safe Screen Off -->
                <Button Name="ScreenOffBtn" Width="26" Height="26" CornerRadius="13"
                        Background="Transparent" BorderThickness="0" Padding="0"
                        ToolTip.Tip="Safe OLED Screen Off (Keep-Alive Mode)" Click="OnScreenOffClick">
                    <Path Data="{StaticResource IconPhone}" Fill="#8B949E" Width="12" Height="12" Stretch="Uniform"
                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Button>

                <!-- Keymap In-Shader HUD Badges -->
                <Button Name="KeymapHudBtn" Width="26" Height="26" CornerRadius="13"
                        Background="Transparent" BorderThickness="0" Padding="0"
                        ToolTip.Tip="Toggle In-Shader Keymap HUD Badges" Click="OnToggleKeymapHudClick">
                    <Path Data="{StaticResource IconKeymapper}" Fill="#8B949E" Width="13" Height="13" Stretch="Uniform"
                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Button>

                <!-- FreeLook Mouse Aim Lock -->
                <Button Name="MouseLockBtn" Width="26" Height="26" CornerRadius="13"
                        Background="Transparent" BorderThickness="0" Padding="0"
                        ToolTip.Tip="Toggle Mouse Aim / FreeLook Lock (F1)" Click="OnMouseLockClick">
                    <Path Data="{StaticResource IconLock}" Fill="#8B949E" Width="12" Height="12" Stretch="Uniform"
                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Button>

                <!-- Audio Mute -->
                <Button Name="AudioBtn" Width="26" Height="26" CornerRadius="13"
                        Background="Transparent" BorderThickness="0" Padding="0"
                        ToolTip.Tip="Mute / Unmute Stream Audio" Click="OnAudioClick">
                    <Path Data="{StaticResource IconVolume}" Fill="#8B949E" Width="13" Height="13" Stretch="Uniform"
                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Button>

                <!-- Fullscreen -->
                <Button Width="26" Height="26" CornerRadius="13"
                        Background="Transparent" BorderThickness="0" Padding="0"
                        ToolTip.Tip="Toggle Fullscreen" Click="OnFullscreenClick">
                    <Path Data="{StaticResource IconFullscreen}" Fill="#F0F6FC" Width="12" Height="12" Stretch="Uniform"
                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Button>

                <!-- Close -->
                <Button Width="26" Height="26" CornerRadius="13"
                        Background="#FF525222" BorderThickness="0" Padding="0"
                        ToolTip.Tip="Close Viewport" Click="OnCloseClick">
                    <Path Data="{StaticResource IconClose}" Fill="#FF5252" Width="11" Height="11" Stretch="Uniform"
                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</Window>
