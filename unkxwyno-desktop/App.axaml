<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Unkxwyno.Desktop.App"
             RequestedThemeVariant="Dark">
    <Application.Styles>
        <FluentTheme />
    </Application.Styles>

    <Application.Resources>
        <!-- unkXwyno Brand Colors -->
        <Color x:Key="BrandPrimary">#00E5FF</Color>
        <Color x:Key="BrandSecondary">#6366F1</Color>
        <Color x:Key="BgDark">#0B0E14</Color>
        <Color x:Key="SidebarDark">#0E121A</Color>
        <Color x:Key="SurfaceCard">#141923</Color>
        <Color x:Key="BorderSubtle">#232B3A</Color>
        <Color x:Key="TextPrimary">#F0F6FC</Color>
        <Color x:Key="TextSecondary">#8B949E</Color>
        <Color x:Key="StatusGreen">#00E676</Color>
        <Color x:Key="AccentGold">#FBBF24</Color>

        <SolidColorBrush x:Key="BrandPrimaryBrush" Color="{StaticResource BrandPrimary}" />
        <SolidColorBrush x:Key="BrandSecondaryBrush" Color="{StaticResource BrandSecondary}" />
        <SolidColorBrush x:Key="BgDarkBrush" Color="{StaticResource BgDark}" />
        <SolidColorBrush x:Key="SidebarDarkBrush" Color="{StaticResource SidebarDark}" />
        <SolidColorBrush x:Key="SurfaceCardBrush" Color="{StaticResource SurfaceCard}" />
        <SolidColorBrush x:Key="BorderSubtleBrush" Color="{StaticResource BorderSubtle}" />
        <SolidColorBrush x:Key="StatusGreenBrush" Color="{StaticResource StatusGreen}" />
        <SolidColorBrush x:Key="AccentGoldBrush" Color="{StaticResource AccentGold}" />

        <!-- Crisp Professional SVG Icons (Anti-AI Emojis) -->
        <StreamGeometry x:Key="IconLogo">M11 2L5 13h5v9l6-11h-5l4-9z</StreamGeometry>
        <StreamGeometry x:Key="IconHome">M10 20v-6h4v6h5v-8h3L12 3 2 12h3v8z</StreamGeometry>
        <StreamGeometry x:Key="IconProfiles">M4 6h16M4 12h16M4 18h10</StreamGeometry>
